{
  "name": "scoped-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p console/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:oidc": "tsx scripts/oidc-demo.ts",
    "audit:verify": "tsx scripts/audit.ts",
    "bench": "tsx scripts/bench.ts",
    "redteam": "tsx scripts/redteam.ts",
    "provision": "tsx scripts/provision.ts",
    "test:browser": "playwright test console.spec.ts",
    "test:oidc": "playwright test oidc.spec.ts",
    "console:dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "canonicalize": "2.1.0",
    "express": "5.3.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "pino": "9.12.0",
    "prom-client": "15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "fast-check": "4.3.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
